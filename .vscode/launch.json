{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Lokal",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "source ~/.nvm/nvm.sh && nvm use 24.18 && npm start"
      ],
      "cwd": "${workspaceRoot}"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Multiplayer",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "multiplayer"],
      "cwd": "${workspaceRoot}"
    }
  ]
}
